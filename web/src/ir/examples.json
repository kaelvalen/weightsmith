      {
       "id": "mem",
       "type": "PythonModule",
       "label": "associative memory",
       "params": {
        "code": "class AssociativeMemory(nn.Module):\n    \"\"\"Linear-attention associative memory: M = \u03a3 \u03c6(k)\u1d40v, read with \u03c6(q).\"\"\"\n\n    def __init__(self, dim: int, heads: int = 4):\n        super().__init__()\n        self.heads = heads\n        self.qkv = nn.Linear(dim, 3 * dim)\n        self.out = nn.Linear(dim, dim)\n\n    def forward(self, x):\n        B, T, D = x.shape\n        q, k, v = self.qkv(x).view(B, T, 3, self.heads, D // self.heads).unbind(2)\n        q, k = F.elu(q) + 1, F.elu(k) + 1\n        memory = torch.einsum(\"bthd,bthe->bhde\", k, v)\n        norm = torch.einsum(\"bthd,bhd->bth\", q, k.sum(1)).unsqueeze(-1)\n        y = torch.einsum(\"bthd,bhde->bthe\", q, memory) / (norm + 1e-6)\n        return self.out(y.reshape(B, T, D))\n\n    @staticmethod\n    def infer_shape(inputs):\n        return {\"out\": inputs[\"x\"]}\n",
        "class_name": "AssociativeMemory",
        "init": {
         "dim": 64,
         "heads": 4
        }
       }
