{
  "schema": 1,
  "name": "Tiny Transformer \u00b7 reverse",
  "nodes": [
    {
      "id": "tokens",
      "type": "Input",
      "params": {
        "shape": [
          "B",
          16
        ],
        "dtype": "i64",
        "field": "x"
      }
    },
    {
      "id": "emb",
      "type": "Embedding",
      "label": "token embedding",
      "params": {
        "num": 16,
        "dim": 64
      }
    },
    {
      "id": "pos",
      "type": "PositionalEmbedding",
      "params": {
        "max_len": 64,
        "dim": 64
      }
    },
    {
      "id": "blocks",
      "type": "Subgraph",
      "label": "2\u00d7 encoder block",
      "params": {
        "graph": "block",
        "repeat": 2
      }
    },
    {
      "id": "norm",
      "type": "LayerNorm",
      "params": {
        "dim": 64
      }
    },
    {
      "id": "head",
      "type": "Linear",
      "params": {
        "in": 64,
        "out": 16
      }
    },
    {
      "id": "loss",
      "type": "CrossEntropy"
    }
  ],
  "edges": [
    [
      "tokens.out",
      "emb.in"
    ],
    [
      "emb.out",
      "pos.in"
    ],
    [
      "pos.out",
      "blocks.x"
    ],
    [
      "blocks.out",
      "norm.in"
    ],
    [
      "norm.out",
      "head.in"
    ],
    [
      "head.out",
      "loss.logits"
    ]
  ],
  "subgraphs": {
    "block": {
      "nodes": [
        {
          "id": "x",
          "type": "Input",
          "params": {
            "shape": [
              "B",
              "T",
              64
            ]
          }
        },
        {
          "id": "ln1",
          "type": "LayerNorm",
          "params": {
            "dim": 64
          }
        },
        {
          "id": "attn",
          "type": "Attention",
          "params": {
            "dim": 64,
            "heads": 4
          }
        },
        {
          "id": "res1",
          "type": "Add"
        },
        {
          "id": "ln2",
          "type": "LayerNorm",
          "params": {
            "dim": 64
          }
        },
        {
          "id": "mlp",
          "type": "MLP",
          "params": {
            "dim": 64,
            "hidden": 256
          }
        },
        {
          "id": "res2",
          "type": "Add"
        },
        {
          "id": "out",
          "type": "Output"
        }
      ],
      "edges": [
        [
          "x.out",
          "ln1.in"
        ],
        [
          "ln1.out",
          "attn.in"
        ],
        [
          "x.out",
          "res1.a"
        ],
        [
          "attn.out",
          "res1.b"
        ],
        [
          "res1.out",
          "ln2.in"
        ],
        [
          "ln2.out",
          "mlp.in"
        ],
        [
          "res1.out",
          "res2.a"
        ],
        [
          "mlp.out",
          "res2.b"
        ],
        [
          "res2.out",
          "out.in"
        ]
      ]
    }
  }
}
